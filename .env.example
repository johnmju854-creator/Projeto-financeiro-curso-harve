# Copie este arquivo para .env.local e preencha com os dados do SEU projeto no Supabase
# (Supabase > Project Settings > API). Nunca coloque chaves no codigo nem suba o .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Use a chave "anon" (ou "publishable"). NUNCA use a "service_role" aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-ou-publishable
